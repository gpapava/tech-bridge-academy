generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  VISITOR
  SCHOOL
  COMPANY
  ADMIN
}

enum OrgType {
  SCHOOL
  COMPANY
}

enum SchoolType {
  SCIENTIFIC_TECHNICAL_SIXTH_FORM
  VOCATIONAL_COLLEGE
  VET_CENTRE
  HIGHER_TECHNICAL_INSTITUTE
  OTHER
}

enum CompanyType {
  MANUFACTURING_SME
  MICRO_ENTERPRISE
  LARGE_ENTERPRISE
  CONTINUING_EDUCATION
  OTHER
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InitiativeType {
  WORK_BASED_LEARNING
  CURRICULUM_INNOVATION
  PARTNERSHIP
  MOBILITY
  INTERNATIONAL_TRAINING_ACTIVITIES
  OTHER
}

enum VisibilityStatus {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum MatchStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT
}

enum SurveyQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING
  DATE
}

// ─── Auth Models (NextAuth v4 compatible) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User Model ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(VISITOR)
  gdprConsent   Boolean   @default(false)
  isActive      Boolean   @default(true)
  language      String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  profile            OrganisationProfile?
  notifications      Notification[]
  eventRegistrations EventRegistration[]
  surveyResponses    SurveyResponse[]
  analyticsEvents    AnalyticsEvent[]
  coDesignRequests   CoDesignRequest[]    @relation("CoDesignRequester")
  networkingPosts    NetworkingPost[]
}

// ─── Organisation Profiles ────────────────────────────────────────────────────

model OrganisationProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  orgType            OrgType
  schoolType         SchoolType?
  companyType        CompanyType?
  name               String
  description        String           @db.Text
  mission            String           @db.Text
  dialogueExperience String?          @db.Text
  opportunities      String           @db.Text
  needs              String           @db.Text
  regions            String[]
  sectors            String[]
  tags               String[]
  city               String?
  country            String?
  latitude           Float?
  longitude          Float?
  contactEmail       String?
  telephone          String?
  website            String?
  socialLinks        Json?
  logoUrl            String?
  visibilityStatus   VisibilityStatus @default(MEMBERS_ONLY)
  validationStatus   ValidationStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        ProfileDocument[]
  matchesAsA       Match[]           @relation("MatchProfileA")
  matchesAsB       Match[]           @relation("MatchProfileB")
  coDesignRequests CoDesignRequest[] @relation("CoDesignProfile")
  skillNeeds       SkillNeed[]
  surveyResponses  SurveyResponse[]
}

model ProfileDocument {
  id        String   @id @default(cuid())
  profileId String
  name      String
  url       String
  fileType  String
  sizeBytes Int?
  createdAt DateTime @default(now())

  profile OrganisationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Matching Engine ──────────────────────────────────────────────────────────

model Match {
  id         String      @id @default(cuid())
  profileAId String
  profileBId String
  score      Int
  reasons    String[]
  status     MatchStatus @default(PENDING_REVIEW)
  adminNotes String?     @db.Text
  reportSent Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  profileA OrganisationProfile @relation("MatchProfileA", fields: [profileAId], references: [id])
  profileB OrganisationProfile @relation("MatchProfileB", fields: [profileBId], references: [id])
  report   MatchReport?

  @@unique([profileAId, profileBId])
}

model MatchReport {
  id          String    @id @default(cuid())
  matchId     String    @unique
  content     String    @db.Text
  generatedBy String    @default("rule-based")
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// ─── Repository of Initiatives ────────────────────────────────────────────────

model RepositoryInitiative {
  id             String           @id @default(cuid())
  title          String
  initiativeType InitiativeType   @default(PARTNERSHIP)
  actors         String           @db.Text
  description    String           @db.Text
  results        String           @db.Text
  challenges     String?          @db.Text
  lessons        String?          @db.Text
  contactEmail   String?
  externalLinks  String[]
  videoUrl       String?
  images         String[]
  tags           String[]
  country        String?
  region         String?
  sector         String?
  publishStatus  ValidationStatus @default(PENDING)
  viewCount      Int              @default(0)
  downloadCount  Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  documents RepositoryDocument[]
}

model RepositoryDocument {
  id           String   @id @default(cuid())
  initiativeId String
  name         String
  url          String
  fileType     String
  createdAt    DateTime @default(now())

  initiative RepositoryInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
}

// ─── Career Guidance Content ──────────────────────────────────────────────────

model CareerContent {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  category       String
  videoUrl       String?
  imageUrl       String?
  targetAudience String[]
  tags           String[]
  isPublished    Boolean  @default(false)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Co-Design Workflow ───────────────────────────────────────────────────────

model CoDesignRequest {
  id           String           @id @default(cuid())
  requesterId  String
  profileId    String
  title        String
  description  String           @db.Text
  partnerNotes String?          @db.Text
  status       ValidationStatus @default(PENDING)
  adminNotes   String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requester User                @relation("CoDesignRequester", fields: [requesterId], references: [id])
  profile   OrganisationProfile @relation("CoDesignProfile", fields: [profileId], references: [id])
}

// ─── Networking Board ─────────────────────────────────────────────────────────

enum NetworkingPostType {
  ANNOUNCEMENT
  REQUEST
  OFFER
}

model NetworkingPost {
  id        String             @id @default(cuid())
  authorId  String
  type      NetworkingPostType
  title     String
  message   String             @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── Educational Resources ────────────────────────────────────────────────────

model EducationalResource {
  id            String    @id @default(cuid())
  title         String
  description   String    @db.Text
  category      String
  resourceType  String
  fileUrl       String?
  externalUrl   String?
  thumbnailUrl  String?
  tags          String[]
  effort        String?
  targetRole    UserRole?
  isPublished   Boolean   @default(false)
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  eventType   String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isVirtual   Boolean   @default(false)
  meetingUrl  String?
  imageUrl    String?
  capacity    Int?
  targetRole  UserRole?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─── Surveys & Skills Needs ───────────────────────────────────────────────────

model Survey {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  targetRole  UserRole?
  isActive    Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]
}

model SurveyQuestion {
  id           String             @id @default(cuid())
  surveyId     String
  text         String
  questionType SurveyQuestionType
  options      String[]
  required     Boolean            @default(false)
  order        Int
  createdAt    DateTime           @default(now())

  survey  Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers QuestionAnswer[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  userId      String
  profileId   String?
  submittedAt DateTime @default(now())

  survey  Survey               @relation(fields: [surveyId], references: [id])
  user    User                 @relation(fields: [userId], references: [id])
  profile OrganisationProfile? @relation(fields: [profileId], references: [id])
  answers QuestionAnswer[]
}

model QuestionAnswer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  value      String @db.Text

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id])
}

model SkillNeed {
  id          String   @id @default(cuid())
  profileId   String
  skill       String
  category    String
  urgency     String
  sector      String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  profile OrganisationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── News ─────────────────────────────────────────────────────────────────────

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  excerpt     String?
  imageUrl    String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  reportType  String
  targetRole  UserRole?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
